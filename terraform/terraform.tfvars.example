# Azure Infrastructure Configuration
# Copy this file to terraform.tfvars and fill in your environment values

resource_group_name            = "m365-myaacoub"
location                       = "westus2"
app_service_plan_name          = "caldova-showcase-plan"
app_service_name               = "ai-content-understanding-ui"
environment                    = "production"
azure_ai_services_endpoint     = "https://foundry-myaacoub.cognitiveservices.azure.com/"
azure_content_safety_endpoint  = "https://foundry-myaacoub.cognitiveservices.azure.com/contentsafety"
node_default_version           = "~20"
